import { Theme } from "theme.slint";
import { Choice } from "choice-list.slint";
import { WelcomeScreen } from "screens/welcome.slint";
import { NetworkScreen, WifiNetwork, WifiStatus } from "screens/network.slint";
import { KeyboardScreen } from "screens/keyboard.slint";
import { TimezoneScreen } from "screens/timezone.slint";
import { DiskScreen, DiskInfo } from "screens/disk.slint";
import { AccountScreen } from "screens/account.slint";
import { SummaryScreen } from "screens/summary.slint";
import { InstallingScreen } from "screens/installing.slint";
import { DoneScreen } from "screens/done.slint";
import { ErrorScreen } from "screens/error.slint";

export { Choice, DiskInfo, Theme, WifiNetwork, WifiStatus }

// SPEC.md "User flow": nine screens, linear, with Back on every screen
// until Install is pressed; Network only appears when offline; an
// install that fails goes to the error screen instead of Done.
export component AppWindow inherits Window {
    title: Theme.product-name;
    icon: Theme.icon;
    preferred-width: 820px;
    preferred-height: 620px;
    min-width: 640px;
    min-height: 520px;

    // 0 Welcome, 1 Network, 2 Keyboard, 3 Timezone, 4 Disk, 5 Account,
    // 6 Summary, 7 Installing, 8 Done, 9 Error.
    in-out property <int> current-screen: 0;

    // The backend's probes (SPEC.md "Architecture"), filled in by Rust
    // once they answer.
    in-out property <bool> probing: true;
    in-out property <string> probe-error;
    in-out property <bool> is-offline: false;
    in-out property <bool> is-uefi: true;
    in-out property <bool> is-setup-mode: false;
    // The firmware already enforces Secure Boot, with its own keys.
    in-out property <bool> firmware-secure-boot: false;
    in property <[DiskInfo]> disks;

    // Wi-Fi, through NetworkManager (the Network screen).
    in property <[WifiNetwork]> wifi-networks;
    in-out property <bool> wifi-available: true;
    in-out property <bool> wifi-busy;
    in-out property <WifiStatus> wifi-status;
    in-out property <string> wifi-status-detail;
    in-out property <string> selected-ssid;
    in-out property <string> wifi-password;
    in-out property <string> network-profile;

    // The lists the Welcome, Keyboard and Timezone screens pick from,
    // already narrowed to what each search field matches, and how each
    // shows what's picked.
    in property <[Choice]> locale-choices;
    in-out property <string> locale-query;
    in-out property <string> locale-label: "en_US.UTF-8";
    in property <[Choice]> keyboard-choices;
    in-out property <string> keyboard-query;
    in-out property <string> keyboard-label: "us";
    // Why the live session's keyboard couldn't be switched to it.
    in-out property <string> keyboard-switch-error;
    in property <[Choice]> timezone-choices;
    in-out property <string> timezone-query;
    in-out property <string> timezone-label;

    // Plan fields, one group per screen.
    in-out property <string> locale: "en_US.UTF-8";
    in-out property <string> kb-layout: "us";
    in-out property <string> kb-variant;
    in-out property <string> kb-preview;
    in-out property <string> timezone;
    in-out property <string> selected-device;
    in-out property <string> selected-model;
    in-out property <int> selected-size-gib;
    in-out property <string> selected-serial;
    in-out property <string> disk-mode: "erase";
    in-out property <bool> secure-boot-enroll;
    in-out property <string> full-name;
    in-out property <string> username;
    in-out property <string> hostname;
    in-out property <string> password;
    in-out property <bool> autologin;
    in-out property <bool> autologin-option: true;
    in-out property <string> summary-problems;

    // The install, as the backend reports it.
    in-out property <int> install-step-number;
    in-out property <string> install-step-name;
    in-out property <float> install-progress;
    in property <[string]> install-log;
    in-out property <bool> show-install-log;
    // The window was asked to close mid-install.
    in-out property <bool> confirm-stop;
    in-out property <int> error-step;
    in-out property <string> error-message;
    in-out property <string> error-log;
    in-out property <bool> error-offline-fallback;
    in-out property <string> saved-log-path;
    in-out property <string> save-log-error;
    in-out property <string> restart-error;

    callback locale-query-edited(string);
    callback locale-picked(Choice);
    callback keyboard-shown();
    callback keyboard-query-edited(string);
    callback keyboard-picked(Choice);
    callback timezone-query-edited(string);
    callback timezone-picked(Choice);
    callback full-name-edited(string);
    callback username-edited(string);
    callback hostname-edited(string);
    callback wifi-rescan();
    callback wifi-join();
    callback install-confirmed();
    callback retry-install();
    callback install-offline();
    callback save-log();
    callback restart-requested();
    callback quit-requested();

    // Reaching the Keyboard screen switches the live session to the
    // layout it shows: from the event loop, whether or not a frame has
    // been drawn yet.
    changed current-screen => {
        if (current-screen == 2) {
            root.keyboard-shown();
        }
    }

    public function go-next() {
        if (current-screen == 0) {
            current-screen = is-offline ? 1 : 2;
        } else if (current-screen == 1) {
            current-screen = 2;
        } else if (current-screen < 6) {
            current-screen += 1;
        }
    }

    function go-back() {
        if (current-screen == 2 && is-offline) {
            current-screen = 1;
        } else if (current-screen == 2 && !is-offline) {
            current-screen = 0;
        } else if (current-screen > 0 && current-screen <= 6) {
            current-screen -= 1;
        }
    }

    if current-screen == 0: WelcomeScreen {
        locales: root.locale-choices;
        locale: root.locale;
        locale-label: root.locale-label;
        locale-query <=> root.locale-query;
        locale-query-edited(text) => { root.locale-query-edited(text); }
        locale-picked(choice) => { root.locale-picked(choice); }
        is-uefi: root.is-uefi;
        probing: root.probing;
        probe-error: root.probe-error;
        try-live-session => { root.quit-requested(); }
        install => { root.go-next(); }
    }

    if current-screen == 1: NetworkScreen {
        networks: root.wifi-networks;
        wifi-available: root.wifi-available;
        busy: root.wifi-busy;
        status: root.wifi-status;
        status-detail: root.wifi-status-detail;
        selected-ssid <=> root.selected-ssid;
        password <=> root.wifi-password;
        back => { root.go-back(); }
        rescan => { root.wifi-rescan(); }
        join => { root.wifi-join(); }
        skip => {
            root.network-profile = "";
            root.go-next();
        }
    }

    if current-screen == 2: KeyboardScreen {
        keyboards: root.keyboard-choices;
        keyboard: root.kb-variant == "" ? root.kb-layout : root.kb-layout + "(" + root.kb-variant + ")";
        keyboard-label: root.keyboard-label;
        keyboard-query <=> root.keyboard-query;
        keyboard-query-edited(text) => { root.keyboard-query-edited(text); }
        keyboard-picked(choice) => { root.keyboard-picked(choice); }
        switch-error: root.keyboard-switch-error;
        preview-text <=> root.kb-preview;
        back => { root.go-back(); }
        next => { root.go-next(); }
    }

    if current-screen == 3: TimezoneScreen {
        timezones: root.timezone-choices;
        timezone: root.timezone;
        timezone-label: root.timezone-label;
        timezone-query <=> root.timezone-query;
        timezone-query-edited(text) => { root.timezone-query-edited(text); }
        timezone-picked(choice) => { root.timezone-picked(choice); }
        back => { root.go-back(); }
        next => { root.go-next(); }
    }

    if current-screen == 4: DiskScreen {
        disks: root.disks;
        selected-device <=> root.selected-device;
        selected-model <=> root.selected-model;
        selected-size-gib <=> root.selected-size-gib;
        selected-serial <=> root.selected-serial;
        mode <=> root.disk-mode;
        is-setup-mode: root.is-setup-mode;
        secure-boot-enroll <=> root.secure-boot-enroll;
        back => { root.go-back(); }
        next => { root.go-next(); }
    }

    if current-screen == 5: AccountScreen {
        full-name <=> root.full-name;
        username <=> root.username;
        hostname <=> root.hostname;
        password <=> root.password;
        autologin <=> root.autologin;
        autologin-option: root.autologin-option;
        full-name-edited(text) => { root.full-name-edited(text); }
        username-edited(text) => { root.username-edited(text); }
        hostname-edited(text) => { root.hostname-edited(text); }
        back => { root.go-back(); }
        next => { root.go-next(); }
    }

    if current-screen == 6: SummaryScreen {
        locale-label: root.locale-label;
        keyboard-label: root.keyboard-label;
        timezone-label: root.timezone-label;
        disk-model: root.selected-model;
        disk-size-gib: root.selected-size-gib;
        disk-serial: root.selected-serial;
        disk-device: root.selected-device;
        is-offline: root.is-offline;
        network-profile: root.network-profile;
        full-name: root.full-name;
        username: root.username;
        hostname: root.hostname;
        autologin: root.autologin && root.autologin-option;
        secure-boot-enroll: root.secure-boot-enroll;
        problems: root.summary-problems;
        back => {
            root.summary-problems = "";
            root.go-back();
        }
        confirm => { root.install-confirmed(); }
    }

    if current-screen == 7: InstallingScreen {
        step-number: root.install-step-number;
        step-name: root.install-step-name;
        progress: root.install-progress;
        log-lines: root.install-log;
        show-log <=> root.show-install-log;
        confirm-stop <=> root.confirm-stop;
        stop => { root.quit-requested(); }
    }

    if current-screen == 8: DoneScreen {
        secure-boot-enroll: root.secure-boot-enroll;
        firmware-secure-boot: root.firmware-secure-boot;
        restart-error: root.restart-error;
        restart => { root.restart-requested(); }
        keep-live-session => { root.quit-requested(); }
    }

    if current-screen == 9: ErrorScreen {
        step: root.error-step;
        message: root.error-message;
        log-tail: root.error-log;
        offline-fallback: root.error-offline-fallback;
        saved-log-path: root.saved-log-path;
        save-log-error: root.save-log-error;
        retry => { root.retry-install(); }
        install-offline => { root.install-offline(); }
        save-log => { root.save-log(); }
        quit => { root.quit-requested(); }
    }
}
