import { Button, LineEdit } from "std-widgets.slint";
import { Choice, ChoiceList } from "../choice-list.slint";

// SPEC.md: "Layout and variant | Live preview field". Every XKB layout
// and variant is one entry of the list, pre-selected from the language
// on the Welcome screen. Rust switches the live session to the layout
// this screen shows, and to each one picked, so the preview field (and
// the password, later) types in it (DECISIONS.md, M4 follow-ups).
export component KeyboardScreen inherits VerticalLayout {
    in property <[Choice]> keyboards;
    // The picked keyboard as XKB writes it, `de` or `de(nodeadkeys)`,
    // and how the list shows it.
    in property <string> keyboard;
    in property <string> keyboard-label;
    in-out property <string> keyboard-query;
    in-out property <string> preview-text;
    // Why the live session couldn't be switched; empty when it was.
    in property <string> switch-error;

    callback keyboard-query-edited(string);
    callback keyboard-picked(Choice);
    callback back();
    callback next();

    padding: 32px;
    spacing: 14px;

    Text { text: @tr("Keyboard"); font-size: 22px; font-weight: 700; }
    Text {
        text: @tr("Layout: {}", keyboard-label);
        font-weight: 600;
    }

    ChoiceList {
        vertical-stretch: 1;
        choices: root.keyboards;
        selected: root.keyboard;
        search-label: @tr("Search keyboard layouts");
        query <=> root.keyboard-query;
        query-edited(text) => { root.keyboard-query-edited(text); }
        picked(choice) => { root.keyboard-picked(choice); }
    }

    Text { text: @tr("Try it out"); }
    LineEdit {
        text <=> preview-text;
        placeholder-text: @tr("Type here to check your keyboard");
    }
    if switch-error != "": Text {
        text: @tr("This session's keyboard couldn't be switched, so typing here may not match: {}", switch-error);
        wrap: word-wrap;
        color: #888888;
    }

    HorizontalLayout {
        spacing: 12px;
        Button { text: @tr("Back"); clicked => { back(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Next"); primary: true; enabled: keyboard != ""; clicked => { next(); } }
    }
}
