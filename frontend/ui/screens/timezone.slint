import { Button } from "std-widgets.slint";
import { Choice, ChoiceList } from "../choice-list.slint";

// SPEC.md: "Region and city | Searchable list, guessed from the chosen
// locale." Every zone in tzdata, searchable by region, city or country,
// plus UTC.
export component TimezoneScreen inherits VerticalLayout {
    in property <[Choice]> timezones;
    // The picked zone (`Europe/Berlin`), and how the list shows it.
    in property <string> timezone;
    in property <string> timezone-label;
    in-out property <string> timezone-query;

    callback timezone-query-edited(string);
    callback timezone-picked(Choice);
    callback back();
    callback next();

    padding: 32px;
    spacing: 14px;

    Text { text: @tr("Timezone"); font-size: 22px; font-weight: 700; }
    Text {
        text: @tr("Timezone: {}", timezone-label);
        font-weight: 600;
    }

    ChoiceList {
        vertical-stretch: 1;
        choices: root.timezones;
        selected: root.timezone;
        search-label: @tr("Search cities, regions or countries");
        query <=> root.timezone-query;
        query-edited(text) => { root.timezone-query-edited(text); }
        picked(choice) => { root.timezone-picked(choice); }
    }

    HorizontalLayout {
        spacing: 12px;
        Button { text: @tr("Back"); clicked => { back(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Next"); primary: true; enabled: timezone != ""; clicked => { next(); } }
    }
}
