import { Button, ComboBox } from "std-widgets.slint";

// SPEC.md: "Region and city | Searchable list, guessed from the chosen
// locale." A fixed representative list stands in until M4's timezone
// data lands.
export component TimezoneScreen inherits VerticalLayout {
    in-out property <string> timezone;

    callback back();
    callback next();

    padding: 32px;
    spacing: 16px;

    Text { text: @tr("Timezone"); font-size: 22px; font-weight: 700; }
    Text { text: @tr("Region / City"); }
    ComboBox {
        model: [
            "Europe/Berlin", "Europe/London", "Europe/Paris",
            "America/New_York", "America/Los_Angeles", "America/Chicago",
            "Asia/Tokyo", "Asia/Kolkata", "Australia/Sydney", "Etc/UTC",
        ];
        current-value: timezone;
        selected(value) => { timezone = value; }
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        spacing: 12px;
        Button { text: @tr("Back"); clicked => { back(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Next"); primary: true; enabled: timezone != ""; clicked => { next(); } }
    }
}
