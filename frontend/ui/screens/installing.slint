import { Button, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

// SPEC.md: "Progress bar, current step, optional branded slideshow,
// expandable log." Progress and log lines arrive from the backend as
// they happen. The slideshow is M5's.
export component InstallingScreen inherits VerticalLayout {
    // 0 until the backend reports its first step.
    in property <int> step-number;
    in property <string> step-name;
    // 0.0 to 1.0.
    in property <float> progress;
    in property <[string]> log-lines;
    in-out property <bool> show-log;
    // The window was asked to close: stopping the install needs a yes
    // (DECISIONS.md, M4 follow-ups).
    in-out property <bool> confirm-stop;

    callback stop();

    padding: 32px;
    spacing: 16px;

    Text { text: @tr("Installing"); font-size: 22px; font-weight: 700; horizontal-alignment: center; }
    Text {
        text: step-number == 0 ? @tr("Starting…") : @tr("Step {}: {}", step-number, step-name);
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    ProgressIndicator { progress: progress; height: 8px; }
    Text { text: @tr("{}%", Math.round(progress * 100)); horizontal-alignment: center; color: #888888; }

    HorizontalLayout {
        alignment: center;
        Button {
            text: show-log ? @tr("Hide details") : @tr("Show details");
            clicked => { show-log = !show-log; }
        }
    }

    // Follows the newest line, like a terminal, until scrolled up to read
    // an older one; scrolling back to the bottom follows again. A plain
    // ScrollView rather than a ListView: the GUI keeps at most a few
    // hundred lines, and a ListView's row estimates nudge the scroll
    // position off the last line.
    if show-log: ScrollView {
        property <length> bottom: min(0px, self.visible-height - self.content-height);
        property <bool> following: true;
        vertical-stretch: 1;
        changed content-height => { if (following) { self.content-y = bottom; } }
        changed visible-height => { if (following) { self.content-y = bottom; } }
        scrolled => { following = self.content-y <= bottom + 1px; }
        VerticalLayout {
            for line in log-lines: Text {
                text: line;
                font-family: "monospace";
                font-size: 11px;
                wrap: no-wrap;
            }
        }
    }

    if !show-log: Rectangle { vertical-stretch: 1; }

    if confirm-stop: Rectangle {
        border-radius: 6px;
        border-width: 2px;
        border-color: #d9534f;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: @tr("Stop the install?");
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: @tr("The disk has already been changed. Stopping now leaves it partly installed, and it won't start until {} is installed on it again.", Theme.product-name);
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Stop and quit"); clicked => { root.stop(); } }
                Button {
                    text: @tr("Keep installing");
                    primary: true;
                    clicked => { root.confirm-stop = false; }
                }
            }
        }
    }
}
